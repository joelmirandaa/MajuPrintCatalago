{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majuprint-catalogo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalogo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "fotos" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    // Preencher com os valores reais do painel do Cloudflare (seção 13 do estrutura.md).
    "ACCESS_TEAM_DOMAIN": "PREENCHER.cloudflareaccess.com",
    // Chave de teste do Turnstile (sempre aprova). Trocar pela chave real em produção.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
